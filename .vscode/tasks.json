{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Flutter: run on all devices (-d all)",
            "type": "shell",
            "command": "flutter",
            "args": [
                "run",
                "-d",
                "all",
                "--dart-define-from-file",
                "dart_defines/inve.json"
            ],
            "options": {
                "cwd": "${workspaceFolder}/app"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            }
        }
    ]
}
