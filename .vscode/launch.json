{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach to Process",
            "type": "lldb",
            "request": "attach",
            "pid": "${command:pickProcess}"
        },
        {
            "name": "App",
            "type": "dart",
            "cwd": "${workspaceFolder}/app",
            "request": "launch",
            "program": "lib/main.dart",
            "args": [
                "--dart-define-from-file",
                "dart_defines/inve.json"
            ]
        },
        {
            "name": "App-Release",
            "type": "dart",
            "cwd": "${workspaceFolder}/app",
            "request": "launch",
            "program": "lib/main.dart",
            "flutterMode": "release",
            "args": [
                "--dart-define-from-file",
                "dart_defines/inve.json"
            ]
        }
    ]
}